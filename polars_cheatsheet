    index="city",
    on=["2025", "2026"],
    variable_name="year",
    value_name="sales",
)

# Explode list columns
df.explode("items")

# Add row index
df.with_row_index("index")

# Transpose
df.transpose()

# Pivot output columns depend on the data.
# Check actual wide.columns before unpivoting.


