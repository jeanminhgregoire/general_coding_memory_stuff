# 23. ADVANCED EXPRESSION PATTERNS
# =============================================================================

# Reusable expression function
def normalize(column: str) -> pl.Expr:
    x = pl.col(column)

    return (
        (x - x.mean()) / x.std()
    ).alias(f"{column}_zscore")


result = df.with_columns(
    normalize("salary"),
    normalize("age"),
)

# Horizontal operations
df.with_columns(
    pl.sum_horizontal(
        "math", "science", "english"
    ).alias("total"),

    pl.max_horizontal(
        "a", "b", "c"
    ).alias("row_max"),

    pl.min_horizontal(
        "a", "b", "c"
    ).alias("row_min"),

    pl.mean_horizontal(
        "a", "b", "c"
    ).alias("row_mean"),
)

# Conditional aggregation
df.group_by("city").agg(
    pl.col("salary")
    .filter(pl.col("age") >= 30)
    .mean()
    .alias("avg_salary_age_30_plus")
)

# Selectors
