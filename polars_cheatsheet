df.rename({"name": "employee", "salary": "pay"})

df.drop("age")
df.drop(["age", "city"])

df.select("name", "salary", "age", "city")

df.select(pl.all().name.prefix("raw_"))
df.select(pl.all().name.suffix("_clean"))

df.select(pl.col("^sales_.*$"))

df.rename(lambda name: name.lower())

df.select(cs.numeric())

# .select() keeps only selected columns.
