# =============================================================================
# 2. CORE CONCEPTS
# =============================================================================
#
# DataFrame: Two-dimensional table.
# Series: One typed column.
# Expression (pl.Expr): Composable description of a computation.
# LazyFrame: Query plan optimized before execution.

df = pl.DataFrame({"x": [1, 2, 3]})
s = pl.Series("x", [1, 2, 3])

# Eager execution
df.filter(pl.col("x") > 1)

# Lazy execution
df.lazy().filter(pl.col("x") > 1).collect()


# =============================================================================
# 3. CREATE DATAFRAMES
# =============================================================================

df = pl.DataFrame({
    "name": ["Alice", "Bob", "Carol", "Dan"],
    "age": [25, 30, 35, 28],
    "salary": [50000, 65000, 80000, 58000],
    "city": ["Geneva", "Zurich", "Geneva", "Basel"],
})

# Create from rows
df_rows = pl.DataFrame(
    [("Alice", 25), ("Bob", 30)],
    schema=["name", "age"],
    orient="row",
)

# Explicit schema
df_typed = pl.DataFrame(
    {"id": [1, 2], "value": [10.5, 20.5]},
    schema={"id": pl.Int64, "value": pl.Float64},
)

# Empty DataFrame
empty = pl.DataFrame(
    schema={"id": pl.Int64, "name": pl.String}
)

# Create from dictionaries
df_dicts = pl.DataFrame([
    {"id": 1, "name": "A"},
    {"id": 2, "name": "B"},
])


