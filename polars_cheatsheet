# =============================================================================
# 6. THE FOUR ESSENTIAL EXPRESSION CONTEXTS
# =============================================================================
#
# .select()          Select or calculate output columns.
# .with_columns()    Add or replace columns.
# .filter()          Keep matching rows.
# .group_by().agg()  Aggregate by group.

df.select("name", "salary")

df.select(
    pl.col("salary").mean().alias("avg_salary"),
    pl.col("age").max().alias("max_age"),
)

df.with_columns(
    (pl.col("salary") * 1.10).alias("new_salary"),
    pl.col("name").str.to_uppercase().alias("name_upper"),
)

df.filter(pl.col("age") >= 30)

df.group_by("city").agg(
    pl.col("salary").mean().alias("avg_salary"),
    pl.len().alias("employee_count"),
)

# Expression building blocks
pl.col("salary")
pl.col("salary").alias("pay")
pl.lit(100)
pl.all()
pl.exclude("id")
pl.col("^sales_.*$")
pl.col(["age", "salary"])
pl.col(pl.Int64)

# Selectors
df.select(cs.numeric())
df.select(cs.string())
df.select(cs.temporal())

# Expressions describe calculations; they are not ordinary
# Python scalar values.


