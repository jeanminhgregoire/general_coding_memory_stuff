# 12. GROUP BY AND AGGREGATE
# =============================================================================

df.group_by("city").agg(
    pl.col("salary").mean().alias("avg_salary")
)

df.group_by(["city", "age"]).agg(
    pl.col("salary").mean().alias("avg_salary"),
