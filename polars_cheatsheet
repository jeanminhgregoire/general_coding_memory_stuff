# =============================================================================
# 17. RANKING, CUMULATIVE OPERATIONS AND WINDOWS
# =============================================================================

# Ranking
df.with_columns(
    pl.col("salary").rank().alias("rank")
)

df.with_columns(
    pl.col("salary").rank(descending=True).alias("rank_desc")
)

df.with_columns(
    pl.col("salary").rank(method="dense").alias("dense_rank")
)

# Cumulative operations
df.with_columns(
    pl.col("salary").cum_sum().alias("cumulative_salary"),
    pl.col("salary").cum_max().alias("running_max"),
    pl.col("salary").cum_min().alias("running_min"),
)

# Previous and next rows
df.with_columns(
    pl.col("salary").shift(1).alias("previous_salary"),
    pl.col("salary").shift(-1).alias("next_salary"),
    pl.col("salary").diff().alias("salary_change"),
)

# Percentage change
df.with_columns(
    (
        pl.col("salary") / pl.col("salary").shift(1) - 1
    ).alias("pct_change")
)

# Grouped windows
df.with_columns(
    pl.col("salary").rank(descending=True).over("city")
    .alias("rank_in_city"),

    pl.col("salary").sum().over("city")
    .alias("city_total"),
)

# Sort before time-series calculations
df.sort("timestamp").with_columns(
    pl.col("value").shift(1).alias("previous_value")
)

# For meaningful time-series calculations, sort by the
# intended ordering column first.


