# 19. RESHAPE: PIVOT, UNPIVOT AND EXPLODE
# =============================================================================

df = pl.DataFrame({
    "city": ["Geneva", "Geneva", "Zurich", "Zurich"],
    "year": [2025, 2026, 2025, 2026],
    "sales": [100, 120, 90, 110],
})

# Long to wide
