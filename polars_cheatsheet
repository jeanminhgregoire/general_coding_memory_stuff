# 25. END-TO-END ANALYTICS PIPELINE
# =============================================================================

result = (
    pl.scan_csv("sales.csv")

    # Clean and convert columns
    .with_columns(
        pl.col("customer").str.strip_chars(),
        pl.col("amount").cast(pl.Float64, strict=False),
        pl.col("date").str.to_date("%Y-%m-%d"),
    )

    # Filter invalid data
    .filter(
        pl.col("amount").is_not_null()
        & (pl.col("amount") >= 0)
    )

    # Transform columns
    .with_columns(
        pl.col("date").dt.truncate("1mo").alias("month"),
        (pl.col("amount") * 1.08).alias("amount_with_tax"),
    )

    # Aggregate data
    .group_by(["month", "customer"])
    .agg(
        pl.col("amount").sum().alias("total_sales"),
        pl.col("amount").mean().alias("average_sale"),
        pl.len().alias("transaction_count"),
    )

    # Rank customers within each month
    .with_columns(
        pl.col("total_sales")
        .rank(method="dense", descending=True)
        .over("month")
        .alias("monthly_rank")
    )

    # Sort results
    .sort(["month", "monthly_rank"])

    # Execute lazy query
    .collect()
)

# Export result
result.write_parquet("sales_summary.parquet")

# Display result
print(result)

