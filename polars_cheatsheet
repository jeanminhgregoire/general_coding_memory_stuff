# =============================================================================
# 8. FILTER ROWS
# =============================================================================

df.filter(pl.col("age") > 30)
df.filter(pl.col("age") >= 30)
df.filter(pl.col("city") == "Geneva")
df.filter(pl.col("city") != "Basel")

# AND / OR / NOT
# Use &, | and ~ instead of Python's and, or and not.

df.filter(
    (pl.col("age") >= 25)
    & (pl.col("salary") > 55000)
)

df.filter(
    (pl.col("city") == "Geneva")
    | (pl.col("city") == "Zurich")
)

df.filter(~(pl.col("city") == "Basel"))

df.filter(pl.col("city").is_in(["Geneva", "Zurich"]))

df.filter(
    pl.col("age").is_between(25, 35, closed="both")
)

# String filters
df.filter(pl.col("name").str.contains("Ali"))
df.filter(pl.col("name").str.starts_with("A"))
df.filter(pl.col("name").str.ends_with("e"))

# Null filters
df.filter(pl.col("salary").is_not_null())
df.filter(pl.col("salary").is_null())

# Always parenthesize individual comparisons when combining
# Polars expressions with &, | and ~.


