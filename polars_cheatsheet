# =============================================================================
# 10. CREATE, TRANSFORM AND CAST COLUMNS
# =============================================================================

df.with_columns(
    (pl.col("salary") + 1000).alias("salary_plus_1000"),
    (pl.col("salary") * 1.10).alias("salary_increased"),
    (pl.col("salary") / 12).alias("monthly_salary"),
)

# Conditional expressions
df.with_columns(
    pl.when(pl.col("salary") >= 70000)
    .then(pl.lit("High"))
    .otherwise(pl.lit("Standard"))
    .alias("salary_band")
)

# Multiple conditions
df.with_columns(
    pl.when(pl.col("salary") >= 75000).then(pl.lit("A"))
    .when(pl.col("salary") >= 60000).then(pl.lit("B"))
    .otherwise(pl.lit("C"))
    .alias("grade")
)

# Casting
pl.col("age").cast(pl.Float64)
pl.col("age").cast(pl.String)
pl.col("age").cast(pl.Int64, strict=False)

# strict=False converts invalid values to null.

