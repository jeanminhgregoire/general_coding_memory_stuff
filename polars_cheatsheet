)

df.group_by("city").agg(
    pl.col("salary").sum().alias("total"),
    pl.col("salary").mean().alias("average"),
    pl.col("salary").median().alias("median"),
    pl.col("salary").min().alias("minimum"),
    pl.col("salary").max().alias("maximum"),
    pl.col("name").n_unique().alias("unique_names"),
)

# Aggregate numeric columns
df.group_by("city").agg(cs.numeric().mean())

# Collect values into lists
df.group_by("city").agg(
    pl.col("name").alias("employees")
)

# Aggregate and sort
(
    df.group_by("city")
    .agg(pl.col("salary").mean().alias("avg_salary"))
    .sort("avg_salary", descending=True)
